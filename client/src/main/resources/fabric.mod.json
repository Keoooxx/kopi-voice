{
    "schemaVersion": 1,
    "id": "plasmovoice",
    "version": "${version}",
    "name": "Kopi Voice",
    "description": "Chat de voz por proximidad de Kopi Studio. Basado en Plasmo Voice (https://github.com/plasmoapp/plasmo-voice), bajo licencia LGPL-3.0.",
    "authors": [
        "Kopi Studio",
        "Plasmo (autores de Plasmo Voice)"
    ],
    "contact": {
        "homepage": "https://github.com/plasmoapp/plasmo-voice",
        "sources": "https://github.com/plasmoapp/plasmo-voice",
        "issues": "https://github.com/plasmoapp/plasmo-voice/issues"
    },
    "license": "LGPL-3.0",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "client": [
            "su.plo.voice.client.ModVoiceClient"
        ],
        "main": [
            "su.plo.voice.ModVoice"
        ],
        "modmenu": [
            "su.plo.voice.client.integration.ModMenuIntegration"
        ]
    },
    "mixins": ["${mixins}"],
    "depends": {
        "${fabricDependencyName}": "${fabricApiVersion}",
        "fabricloader": "*",
        "minecraft": "${mcVersions}"
    }
}
